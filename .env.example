# CodeWithMpho Portfolio – Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git

PORT=3000

# ── SMTP Email (Gmail example) ───────────────────────────────────────────────
# Use an App Password, not your main Gmail password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# The email address that receives contact form + booking notifications
CONTACT_EMAIL=officialcodewithmpho@gmail.com

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
